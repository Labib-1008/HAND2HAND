<!DOCTYPE html>
<html lang="en">
<head>

<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>HAND2HAND - Real-Time Donation Availability Tracking</title>

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

<link rel="stylesheet"
href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

<style>

body{
    background:#eef2f7;
    font-family:Arial, Helvetica, sans-serif;
}

/* Sidebar */

.sidebar{
    width:260px;
    height:100vh;
    position:fixed;
    top:0;
    left:0;
    background:#0f172a;
    padding:20px;
    overflow-y:auto;
}

.sidebar h2{
    color:white;
    text-align:center;
    margin-bottom:30px;
}

.sidebar a{
    display:block;
    color:#cbd5e1;
    text-decoration:none;
    padding:14px;
    border-radius:10px;
    margin-bottom:10px;
    transition:0.3s;
}

.sidebar a:hover{
    background:#1e293b;
    color:white;
}

/* Main Content */

.main-content{
    margin-left:280px;
    padding:30px;
}

/* Navbar */

.top-navbar{
    background:white;
    padding:20px;
    border-radius:18px;
    display:flex;
    justify-content:space-between;
    align-items:center;
    box-shadow:0px 4px 10px rgba(0,0,0,0.08);
}

.user-box{
    display:flex;
    align-items:center;
    gap:10px;
}

.user-box img{
    width:45px;
    height:45px;
    border-radius:50%;
}

/* Stats */

.stats-card{
    background:white;
    padding:25px;
    border-radius:18px;
    margin-top:25px;
    box-shadow:0px 4px 12px rgba(0,0,0,0.08);
    transition:0.3s;
}

.stats-card:hover{
    transform:translateY(-5px);
}

.stats-card i{
    font-size:40px;
    margin-bottom:15px;
}

/* Tracking Cards */

.tracking-card{
    background:white;
    border-radius:18px;
    padding:25px;
    margin-top:25px;
    box-shadow:0px 4px 15px rgba(0,0,0,0.08);
}

.tracking-header{
    display:flex;
    justify-content:space-between;
    align-items:center;
}

.status-live{
    background:#22c55e;
    color:white;
    padding:8px 15px;
    border-radius:25px;
    font-size:14px;
}

.status-low{
    background:#facc15;
    color:black;
    padding:8px 15px;
    border-radius:25px;
}

.status-expired{
    background:#ef4444;
    color:white;
    padding:8px 15px;
    border-radius:25px;
}

/* Progress */

.progress{
    height:22px;
    border-radius:20px;
}

.progress-bar{
    font-weight:bold;
}

/* Buttons */

.refresh-btn{
    background:#2563eb;
    color:white;
    border:none;
    padding:12px 20px;
    border-radius:10px;
}

.refresh-btn:hover{
    background:#1d4ed8;
}

.claim-btn{
    background:#16a34a;
    color:white;
    border:none;
    padding:12px 20px;
    border-radius:10px;
}

.claim-btn:hover{
    background:#15803d;
}

/* Table */

.table-box{
    background:white;
    margin-top:30px;
    padding:25px;
    border-radius:18px;
    box-shadow:0px 4px 12px rgba(0,0,0,0.08);
}

/* Search */

.search-box{
    background:white;
    margin-top:25px;
    padding:20px;
    border-radius:18px;
    box-shadow:0px 4px 10px rgba(0,0,0,0.08);
}

/* Footer */

.footer{
    text-align:center;
    color:gray;
    margin-top:40px;
    padding:20px;
}

/* Responsive */

@media(max-width:992px){

    .sidebar{
        width:100%;
        height:auto;
        position:relative;
    }

    .main-content{
        margin-left:0;
    }

}

</style>

</head>

<body>

<!-- Sidebar -->

<div class="sidebar">

    <h2>HAND2HAND</h2>

    <a href="#">
        <i class="fa fa-chart-line"></i>
        Dashboard
    </a>

    <a href="#">
        <i class="fa fa-box"></i>
        Available Donations
    </a>

    <a href="#">
        <i class="fa fa-clock"></i>
        Real-Time Tracking
    </a>

    <a href="#">
        <i class="fa fa-location-dot"></i>
        Nearby Donations
    </a>

    <a href="#">
        <i class="fa fa-list"></i>
        Donation Logs
    </a>

    <a href="#">
        <i class="fa fa-bell"></i>
        Notifications
    </a>

    <a href="#">
        <i class="fa fa-gear"></i>
        Settings
    </a>

    <a href="#">
        <i class="fa fa-right-from-bracket"></i>
        Logout
    </a>

</div>

<!-- Main Content -->

<div class="main-content">

    <!-- Top Navbar -->

    <div class="top-navbar">

        <div>

            <h3>Real-Time Donation Availability Tracking</h3>

            <p class="text-muted">
                Monitor live donation stock and availability
            </p>

        </div>

        <div class="user-box">

            <img src="https://i.pravatar.cc/100" alt="">

            <div>

                <strong>Tracking Admin</strong>

                <br>

                <small>Live Monitoring</small>

            </div>

        </div>

    </div>

    <!-- Search Box -->

    <div class="search-box">

        <div class="row">

            <div class="col-md-4 mb-3">

                <input type="text"
                class="form-control"
                placeholder="Search Donation">

            </div>

            <div class="col-md-3 mb-3">

                <select class="form-select">

                    <option>All Categories</option>

                    <option>Food</option>

                    <option>Medicine</option>

                    <option>Clothes</option>

                    <option>Education</option>

                </select>

            </div>

            <div class="col-md-3 mb-3">

                <select class="form-select">

                    <option>Availability Status</option>

                    <option>Available</option>

                    <option>Low Stock</option>

                    <option>Expired</option>

                </select>

            </div>

            <div class="col-md-2 mb-3">

                <button class="btn btn-primary w-100">

                    Search

                </button>

            </div>

        </div>

    </div>

    <!-- Stats Cards -->

    <div class="row">

        <div class="col-md-3">

            <div class="stats-card">

                <i class="fa fa-box-open text-primary"></i>

                <h3>245</h3>

                <p>Total Active Donations</p>

            </div>

        </div>

        <div class="col-md-3">

            <div class="stats-card">

                <i class="fa fa-check-circle text-success"></i>

                <h3>190</h3>

                <p>Currently Available</p>

            </div>

        </div>

        <div class="col-md-3">

            <div class="stats-card">

                <i class="fa fa-triangle-exclamation text-warning"></i>

                <h3>35</h3>

                <p>Low Stock Items</p>

            </div>

        </div>

        <div class="col-md-3">

            <div class="stats-card">

                <i class="fa fa-xmark-circle text-danger"></i>

                <h3>20</h3>

                <p>Expired Donations</p>

            </div>

        </div>

    </div>

    <!-- Donation Card 1 -->

    <div class="tracking-card">

        <div class="tracking-header">

            <div>

                <h4>Emergency Food Package</h4>

                <p class="text-muted">
                    Category: Food Relief
                </p>

            </div>

            <span class="status-live">

                Live Available

            </span>

        </div>

        <hr>

        <p><strong>Remaining Quantity:</strong> 18 Packs</p>

        <p><strong>Location:</strong> Dhaka</p>

        <p><strong>Expiry Time:</strong> 10 Hours Left</p>

        <p><strong>Last Updated:</strong> 5 Minutes Ago</p>

        <div class="progress mb-4">

            <div class="progress-bar bg-success"
            style="width:85%">

                85%

            </div>

        </div>

        <button class="refresh-btn">

            <i class="fa fa-rotate"></i>

            Refresh Status

        </button>

        <button class="claim-btn">

            <i class="fa fa-hand"></i>

            Claim Donation

        </button>

    </div>

    <!-- Donation Card 2 -->

    <div class="tracking-card">

        <div class="tracking-header">

            <div>

                <h4>Winter Blanket Support</h4>

                <p class="text-muted">
                    Category: Clothes Donation
                </p>

            </div>

            <span class="status-low">

                Low Stock

            </span>

        </div>

        <hr>

        <p><strong>Remaining Quantity:</strong> 3 Blankets</p>

        <p><strong>Location:</strong> Khulna</p>

        <p><strong>Expiry Time:</strong> 2 Days Left</p>

        <p><strong>Last Updated:</strong> 2 Minutes Ago</p>

        <div class="progress mb-4">

            <div class="progress-bar bg-warning"
            style="width:20%">

                20%

            </div>

        </div>

        <button class="refresh-btn">

            <i class="fa fa-rotate"></i>

            Refresh Status

        </button>

        <button class="claim-btn">

            <i class="fa fa-hand"></i>

            Claim Donation

        </button>

    </div>

    <!-- Donation Card 3 -->

    <div class="tracking-card">

        <div class="tracking-header">

            <div>

                <h4>Medicine Support Box</h4>

                <p class="text-muted">
                    Category: Medical Support
                </p>

            </div>

            <span class="status-expired">

                Expired

            </span>

        </div>

        <hr>

        <p><strong>Remaining Quantity:</strong> 0</p>

        <p><strong>Location:</strong> Rajshahi</p>

        <p><strong>Expiry Time:</strong> Expired</p>

        <p><strong>Last Updated:</strong> 30 Minutes Ago</p>

        <div class="progress mb-4">

            <div class="progress-bar bg-danger"
            style="width:0%">

                0%

            </div>

        </div>

        <button class="refresh-btn">

            <i class="fa fa-rotate"></i>

            Refresh Status

        </button>

    </div>

    <!-- Live Tracking Table -->

    <div class="table-box">

        <h4 class="mb-4">

            Live Donation Availability Logs

        </h4>

        <table class="table table-hover">

            <thead class="table-dark">

                <tr>

                    <th>Donation Name</th>

                    <th>Category</th>

                    <th>Quantity</th>

                    <th>Status</th>

                    <th>Updated Time</th>

                </tr>

            </thead>

            <tbody>

                <tr>

                    <td>Food Package</td>

                    <td>Food</td>

                    <td>18</td>

                    <td>

                        <span class="badge bg-success">

                            Available

                        </span>

                    </td>

                    <td>2 Min Ago</td>

                </tr>

                <tr>

                    <td>Blankets</td>

                    <td>Clothes</td>

                    <td>3</td>

                    <td>

                        <span class="badge bg-warning">

                            Low Stock

                        </span>

                    </td>

                    <td>5 Min Ago</td>

                </tr>

                <tr>

                    <td>Medicine Box</td>

                    <td>Medical</td>

                    <td>0</td>

                    <td>

                        <span class="badge bg-danger">

                            Expired

                        </span>

                    </td>

                    <td>30 Min Ago</td>

                </tr>

            </tbody>

        </table>

    </div>

    <!-- Footer -->

    <div class="footer">

        © 2026 HAND2HAND Donation Platform |
        Real-Time Donation Monitoring System

    </div>

</div>

<script>

const refreshButtons =
document.querySelectorAll('.refresh-btn');

refreshButtons.forEach(button=>{

    button.addEventListener('click',()=>{

        alert('Donation Status Updated Successfully');

    });

});

const claimButtons =
document.querySelectorAll('.claim-btn');

claimButtons.forEach(button=>{

    button.addEventListener('click',()=>{

        alert('Donation Claim Request Sent');

    });

});

</script>

</body>
</html>
